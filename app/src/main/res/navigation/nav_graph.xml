<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/searchUserFragment">

    <fragment
        android:id="@+id/searchUserFragment"
        android:name="com.example.hitachibagusassessment.ui.search.SearchFragment"
        android:label="Search User">

        <action
            android:id="@+id/action_searchUserFragment_to_userDetailFragment"
            app:destination="@id/userDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/userDetailFragment"
        android:name="com.example.hitachibagusassessment.ui.detail.DetailFragment"
        android:label="User Detail">

        <argument
            android:name="username"
            app:argType="string" />
    </fragment>
</navigation>
